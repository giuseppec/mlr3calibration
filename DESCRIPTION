Package: mlr3calibration
Title: Calibration Extension for 'mlr3'
Version: 0.1.0.9000
Authors@R:
    c(person("Giuseppe", "Casalicchio", , "giuseppe.casalicchio@stat.uni-muenchen.de", role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0000-0001-5324-5966")),
      person("Adrian", "Glos", , "adrianglos117@googlemail.com", role = c("aut")),
