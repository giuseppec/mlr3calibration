  mlr3misc::require_namespaces("rpart", quietly = TRUE)) {
  data("Sonar", package = "mlbench")
  task = mlr3::as_task_classif(Sonar, target = "Class", positive = "M")
  learner = mlr3::lrn("classif.rpart", predict_type = "prob")
