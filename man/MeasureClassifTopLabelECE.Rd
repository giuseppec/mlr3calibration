\deqn{\mathrm{TL{-}ECE} = \sum_{k = 1}^{K} \sum_{b = 1}^{B} \frac{|T_{bk}|}{N}\,\left|\mathrm{mean}(z_i : i \in T_{bk}) - \mathrm{mean}(h_i : i \in T_{bk})\right|}

